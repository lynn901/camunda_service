# =============================================================
#   Camunda 7 中心化工作流服务 — 环境变量模板
#   复制此文件为 .env 并按实际情况填写
# =============================================================

# ── 数据库配置 (PostgreSQL) ──────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://camunda-db:5432/camunda_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=yourpassword

# ── Camunda 管理员账号 ────────────────────────────────────────
# 用于登录 Cockpit / Tasklist / Admin 控制台
CAMUNDA_ADMIN_USER=admin
CAMUNDA_ADMIN_PASSWORD=admin

# ── 应用端口 (默认 8080) ──────────────────────────────────────
SERVER_PORT=8080

# ── PostgreSQL 容器配置（docker-compose 使用）────────────────
POSTGRES_DB=camunda_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=yourpassword
